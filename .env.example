# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.
# The same names go in Vercel -> Settings -> Environment Variables for production.

# --- chat tester (/api/chat) ---
CHAT_TEST_PASSWORD=local

# --- model: gemini (default) or anthropic ---
MODEL_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# --- prescription photo in the Saath chat ---
# Default (unset): shows the scripted prescription from the plan, no model needed.
# RX_READER=live reads the uploaded photo with the model (needs GEMINI_API_KEY).
# RX_READER=live

# --- Gnani voice (TTS Timbre + STT Prisma), for /voice.html ---
GNANI_API_KEY=

# --- Twilio WhatsApp (only needed to test /api/whatsapp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
PUBLIC_BASE_URL=http://localhost:3000

# --- optional: dedupe via Upstash Redis ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
